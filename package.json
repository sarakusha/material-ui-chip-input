{
  "name": "@sarakusha/material-ui-chip-input",
  "version": "2.1.0",
  "typings": "typings/index.d.ts",
  "description": "A chip input field using Material-UI.",
  "main": "lib/ChipInput.js",
  "files": [
    "lib/**/*.js",
    "typings/*.d.ts",
    "README.md",
    "LICENSE",
    "demo.gif"
  ],
  "scripts": {
    "build": "babel src -d lib",
    "test": "pnpm run lint && jest",
    "test:coverage": "jest --coverage && cat ./coverage/lcov.info | coveralls",
    "test:unit": "jest",
    "lint": "eslint src stories --ext .js,.jsx",
    "format": "prettier . --write",
    "prepublish": "babel src -d lib",
    "storybook": "pnpm run build && storybook dev -p 6006",
    "storybook:build": "pnpm run build && storybook build",
    "deploy-storybook": "pnpm run storybook:build && gh-pages -d storybook-static"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TeamWertarbyte/material-ui-chip-input.git"
  },
  "keywords": [
    "react",
    "material",
    "chip",
    "input",
    "tags"
  ],
  "author": "Wertarbyte <kontakt@wertarbyte.com> (https://wertarbyte.com)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/TeamWertarbyte/material-ui-chip-input/issues"
  },
  "homepage": "https://github.com/TeamWertarbyte/material-ui-chip-input#readme",
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@babel/preset-env": "^7.29.6",
    "@babel/preset-react": "^7.28.5",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^9.0.1",
    "@storybook/addon-actions": "^9.0.8",
    "@storybook/react": "^10.4.1",
    "@storybook/react-vite": "^10.4.1",
    "autosuggest-highlight": "^3.3.4",
    "babel-loader": "^8.0.6",
    "coveralls": "^3.0.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^1.2.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-autosuggest": "^10.1.0",
    "react-dom": "^19.2.6",
    "storybook": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "globals": "^17.6.0"
  },
  "peerDependencies": {
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/material": "^9.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "classnames": "^2.2.5",
    "prop-types": "^15.6.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "@testing-library/jest-dom"
    ],
    "coveragePathIgnorePatterns": [
      "<rootDir>/test"
    ],
    "roots": [
      "src",
      "test"
    ]
  },
  "packageManager": "pnpm@11.2.2"
}
